{
  "name": "nw4r-web",
  "version": "0.1.0",
  "description": "Conversores NW4R/Wii (.carc, .tpl, .brfnt, .brlan, .kcl) para formatos web (zip, png, json, glb). TypeScript puro.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "nw4r-web": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "convert": "tsx src/cli.ts convert",
    "build:web": "tsx src/build-project.ts ../.. -o ../../../linuxsports-web"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "^0.160.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

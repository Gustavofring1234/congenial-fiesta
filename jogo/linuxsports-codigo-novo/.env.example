# Variáveis de ambiente para as ferramentas OFFLINE (tools/gemini_client.py).
# O cliente lê SOMENTE os.getenv("GEMINI_API_KEY"); este arquivo não é lido por nenhum script.
# Para usar: copie para .env (ignorado pelo git), preencha e exporte no shell:
#   set -a; source .env; set +a
# Nunca coloque a chave em arquivos .js servidos ao navegador (minigames/sports/), em Assets/ ou em builds.
# Usos offline: tools/gemini_client.py (análise do decompiled.c) e tools/translate_texts.py (textos pt/ja).
GEMINI_API_KEY="INSIRA_SUA_CHAVE_AQUI"
# Modelo usado por tools/gemini_client.py (qualquer modelo com generateContent).
GEMINI_MODEL="gemini-flash-latest"

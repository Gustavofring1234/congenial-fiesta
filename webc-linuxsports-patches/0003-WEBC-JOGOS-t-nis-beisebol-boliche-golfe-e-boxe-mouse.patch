+      b.viva = false; b.saque = true; b.quiques = 0; b.lancada = 0; b.batedor = 0;
+      const s = sacador();
+      b.p.set(s.x + s.time * -0.35, 1.0, s.z);
+      b.v.set(0, 0, 0);
+    }
+    const sacador = () => jogadores.find((j) => j.time === placar.sacador);
+    /** O ponto vai para o time "time". */
